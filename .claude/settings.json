{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "allow": [
      "Bash(git push:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git show:*)",
      "Bash(git worktree:*)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(npx oxlint:*)"
    ],
    "deny": [
      "Bash(git fetch:*)",
      "Bash(git remote:*)",
      "Bash(git ls-remote:*)",
      "Bash(git clone:*)",
      "Bash(git archive:*)",
      "Bash(git pull:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(gh:*)"
    ]
  }
}
